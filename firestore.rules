rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile Rules
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isOwner(userId)
        && incoming().userId == request.auth.uid
        && incoming().name is string && incoming().name.size() <= 100
        && incoming().email is string && incoming().email.size() <= 128;
      allow update: if isOwner(userId)
        && incoming().userId == existing().userId;
      allow delete: if isOwner(userId);

      // User Routine Logs
      match /logs/{logId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && incoming().userId == request.auth.uid
          && incoming().routineId in ['squats', 'pushups', 'jumping_jacks', 'plank', 'walk']
          && incoming().score is number;
        allow update: if isOwner(userId)
          && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }
    }

    // Shared Activity Stream & Cheers
    match /activity/{activityId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().routineTitle is string && incoming().routineTitle.size() <= 64
        && incoming().timestamp is number;
      allow update: if isSignedIn()
        && incoming().diff(existing()).affectedKeys().hasOnly(['cheers']);
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
