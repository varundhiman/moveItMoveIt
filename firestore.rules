rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile Rules
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create: if isOwner(userId)
        && incoming().userId == request.auth.uid
        && incoming().name is string && incoming().name.size() <= 100
        && incoming().email is string && incoming().email.size() <= 128;
      allow update: if isOwner(userId)
        && incoming().userId == existing().userId;
      allow delete: if isOwner(userId);

      // User Routine Logs
      match /logs/{logId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && incoming().userId == request.auth.uid
          && incoming().routineId in ['squats', 'pushups', 'jumping_jacks', 'plank', 'walk']
          && incoming().score is number;
        allow update: if isOwner(userId)
          && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }
    }

    // Challenges Collection
    match /challenges/{challengeId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn()
        && incoming().createdBy == request.auth.uid
        && incoming().name is string && incoming().name.size() <= 100
        && incoming().dailyTargetSlots is number
        && incoming().inviteCode is string && incoming().inviteCode.size() <= 32;
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && existing().createdBy == request.auth.uid;

      // Challenge Members Subcollection (Real Leaderboard)
      match /members/{memberUserId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn() && request.auth.uid == memberUserId
          && (incoming().userId == request.auth.uid || incoming().id == request.auth.uid)
          && incoming().name is string && incoming().name.size() <= 100;
        allow update: if isSignedIn() && (
          (request.auth.uid == memberUserId) ||
          (incoming().diff(existing()).affectedKeys().hasOnly(['cheerCount']))
        );
        allow delete: if isSignedIn() && request.auth.uid == memberUserId;
      }

      // Challenge Real-time Activities Subcollection
      match /activities/{activityId} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn()
          && (incoming().userId == request.auth.uid || incoming().id == request.auth.uid)
          && incoming().routineTitle is string && incoming().routineTitle.size() <= 64;
        allow update: if isSignedIn()
          && incoming().diff(existing()).affectedKeys().hasOnly(['cheers']);
        allow delete: if isSignedIn() && (existing().userId == request.auth.uid || existing().id == request.auth.uid);
      }
    }

    // Invitations Collection
    match /invitations/{inviteId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn()
        && (incoming().inviterId == request.auth.uid || incoming().inviterUserId == request.auth.uid)
        && incoming().challengeId is string
        && incoming().inviteCode is string;
      allow update: if isSignedIn()
        && (
          incoming().targetUserId == request.auth.uid ||
          existing().targetUserId == request.auth.uid ||
          incoming().diff(existing()).affectedKeys().hasOnly(['status'])
        );
      allow delete: if isSignedIn() && (
        existing().inviterId == request.auth.uid ||
        existing().targetUserId == request.auth.uid
      );
    }
  }
}
