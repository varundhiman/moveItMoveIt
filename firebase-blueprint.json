{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with workday mobility stats and challenge membership",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Unique Firebase Auth UID"
        },
        "name": {
          "type": "string",
          "description": "User display name",
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "description": "User email address",
          "maxLength": 128
        },
        "avatar": {
          "type": "string",
          "description": "Avatar photo URL",
          "maxLength": 512
        },
        "streakDays": {
          "type": "number",
          "description": "Consecutive challenge streak days"
        },
        "todaySlotsCount": {
          "type": "number",
          "description": "Hourly time slots completed today"
        },
        "totalPoints": {
          "type": "number",
          "description": "Total XP / points earned"
        },
        "currentChallengeId": {
          "type": "string",
          "description": "ID of active challenge",
          "maxLength": 64
        },
        "squadCode": {
          "type": "string",
          "description": "Code of active challenge squad",
          "maxLength": 64
        },
        "squadName": {
          "type": "string",
          "description": "Name of challenge squad",
          "maxLength": 128
        },
        "unlockedBadgeIds": {
          "type": "array",
          "description": "List of unlocked badge IDs"
        },
        "lastActiveTime": {
          "type": "string",
          "description": "Human readable last activity"
        },
        "lastRoutine": {
          "type": "string",
          "description": "Title of last routine performed",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["userId", "name", "email", "todaySlotsCount", "streakDays"]
    },
    "Challenge": {
      "title": "Challenge",
      "description": "Mobility challenge with customizable daily quota and invite code",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Challenge unique identifier"
        },
        "name": {
          "type": "string",
          "description": "Name of challenge",
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "description": "Challenge description or goal",
          "maxLength": 300
        },
        "inviteCode": {
          "type": "string",
          "description": "Shareable invite code",
          "maxLength": 32
        },
        "dailyTargetSlots": {
          "type": "number",
          "description": "Configurable daily activity quota (e.g. 3, 5, etc.)"
        },
        "createdBy": {
          "type": "string",
          "description": "UID of creator"
        },
        "creatorName": {
          "type": "string",
          "description": "Display name of creator",
          "maxLength": 100
        },
        "startDate": {
          "type": "string",
          "description": "Start date YYYY-MM-DD"
        },
        "endDate": {
          "type": "string",
          "description": "End date YYYY-MM-DD"
        },
        "memberCount": {
          "type": "number",
          "description": "Total number of members"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO creation timestamp"
        }
      },
      "required": ["name", "inviteCode", "dailyTargetSlots", "createdBy", "createdAt"]
    },
    "ChallengeMember": {
      "title": "ChallengeMember",
      "description": "Participant in a challenge with real-time stats and points",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "UID of participant"
        },
        "name": {
          "type": "string",
          "description": "Display name",
          "maxLength": 100
        },
        "avatar": {
          "type": "string",
          "description": "Avatar photo URL",
          "maxLength": 512
        },
        "totalPoints": {
          "type": "number",
          "description": "Total points accumulated in this challenge"
        },
        "todayCompletedCount": {
          "type": "number",
          "description": "Slots completed today"
        },
        "todayActivitiesCount": {
          "type": "number",
          "description": "Total routine activities performed today"
        },
        "streakDays": {
          "type": "number",
          "description": "Consecutive days meeting daily quota"
        },
        "lastRoutine": {
          "type": "string",
          "description": "Last routine performed",
          "maxLength": 64
        },
        "lastActiveTime": {
          "type": "string",
          "description": "ISO timestamp of last activity"
        },
        "cheerCount": {
          "type": "number",
          "description": "Cheers received from teammates"
        },
        "joinedAt": {
          "type": "string",
          "description": "ISO timestamp when joined"
        }
      },
      "required": ["userId", "name", "totalPoints", "todayCompletedCount", "streakDays"]
    },
    "ChallengeActivity": {
      "title": "ChallengeActivity",
      "description": "Real-time activity log item in a challenge",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Activity log ID"
        },
        "userId": {
          "type": "string",
          "description": "UID of user who performed routine"
        },
        "userName": {
          "type": "string",
          "description": "User display name",
          "maxLength": 100
        },
        "userAvatar": {
          "type": "string",
          "description": "Avatar URL",
          "maxLength": 512
        },
        "routineId": {
          "type": "string",
          "description": "ID of mobility routine",
          "enum": ["squats", "pushups", "jumping_jacks", "plank", "walk"]
        },
        "routineTitle": {
          "type": "string",
          "description": "Human title of routine",
          "maxLength": 64
        },
        "completedAt": {
          "type": "string",
          "description": "ISO timestamp"
        },
        "isWithin9to5": {
          "type": "boolean",
          "description": "Whether performed during workday challenge window"
        },
        "slotIndex": {
          "type": "number",
          "description": "Hour slot index 0-7"
        },
        "pointsEarned": {
          "type": "number",
          "description": "Points earned for this activity (e.g. 5 base + bonuses)"
        },
        "durationSeconds": {
          "type": "number",
          "description": "Duration in seconds"
        },
        "cheers": {
          "type": "number",
          "description": "Number of cheers received"
        }
      },
      "required": ["userId", "userName", "routineId", "routineTitle", "completedAt", "pointsEarned"]
    },
    "RoutineLog": {
      "title": "RoutineLog",
      "description": "Record of a verified completed mobility routine for a user",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "UID of user who performed routine"
        },
        "routineId": {
          "type": "string",
          "description": "ID of mobility routine",
          "enum": ["squats", "pushups", "jumping_jacks", "plank", "walk"]
        },
        "routineTitle": {
          "type": "string",
          "description": "Human title of routine",
          "maxLength": 64
        },
        "completedAt": {
          "type": "string",
          "description": "ISO timestamp when routine completed"
        },
        "isWithin9to5": {
          "type": "boolean",
          "description": "Whether performed during workday challenge window"
        },
        "slotIndex": {
          "type": "number",
          "description": "Hour slot index 0-7 corresponding to 9am-5pm"
        },
        "score": {
          "type": "number",
          "description": "Points earned for routine"
        },
        "formScore": {
          "type": "number",
          "description": "Computer vision form accuracy percentage"
        },
        "durationSeconds": {
          "type": "number",
          "description": "Duration in seconds"
        }
      },
      "required": ["userId", "routineId", "routineTitle", "completedAt", "score"]
    },
    "GroupInvite": {
      "title": "GroupInvite",
      "description": "Invitation sent to another user to join a challenge squad",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique invite ID"
        },
        "challengeId": {
          "type": "string",
          "description": "ID of challenge"
        },
        "challengeName": {
          "type": "string",
          "description": "Name of challenge",
          "maxLength": 100
        },
        "dailyTargetSlots": {
          "type": "number",
          "description": "Slots per day target"
        },
        "inviteCode": {
          "type": "string",
          "description": "Shareable invite code",
          "maxLength": 32
        },
        "inviterId": {
          "type": "string",
          "description": "UID of person who sent invite"
        },
        "inviterName": {
          "type": "string",
          "description": "Name of person who sent invite",
          "maxLength": 100
        },
        "inviterAvatar": {
          "type": "string",
          "description": "Avatar of inviter",
          "maxLength": 512
        },
        "targetUserId": {
          "type": "string",
          "description": "UID of target recipient user"
        },
        "targetEmail": {
          "type": "string",
          "description": "Email of recipient",
          "maxLength": 128
        },
        "status": {
          "type": "string",
          "description": "Status of invitation",
          "enum": ["pending", "accepted", "declined"]
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation"
        }
      },
      "required": ["challengeId", "challengeName", "inviteCode", "inviterId", "inviterName", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile with mobility challenge scores"
    },
    "/users/{userId}/logs/{logId}": {
      "schema": "RoutineLog",
      "description": "Verified mobility routine logs for user"
    },
    "/challenges/{challengeId}": {
      "schema": "Challenge",
      "description": "Active challenges with configurable daily quotas and invite codes"
    },
    "/challenges/{challengeId}/members/{userId}": {
      "schema": "ChallengeMember",
      "description": "Participant live ranking and points within challenge"
    },
    "/challenges/{challengeId}/activities/{activityId}": {
      "schema": "ChallengeActivity",
      "description": "Live real-time feed of routines completed in challenge"
    },
    "/invitations/{inviteId}": {
      "schema": "GroupInvite",
      "description": "Invitations sent to users to join challenges"
    }
  }
}
